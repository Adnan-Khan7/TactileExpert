venv/
__pycache__/
*.pyc
*.pyo
*.pyd

# API keys / secrets
.env
api_key*
*.key

# Logs
logs/
*.log

# Large data files / model weights
# NOTE: these are ROOT-ANCHORED on purpose. A bare `models/` also matches
# research/models/, which is Python source the review/ and ui/ stacks import —
# an unanchored pattern silently drops it from a clone.
images/
/models/
# install_fleet.py backs the deployed fleet up next to it before overwriting, so
# a ~500MB directory lands in the repo root on every install. /models/ does not
# match it. It stayed untracked only because *.pt and *.safetensors caught the
# weights individually — the directory itself was never ignored.
/models_backup_*/
/models_tv*/
*.jsonl
*.xlsx
*.csv
*.pt
*.safetensors
*.npz
*.ckpt
*.bin
~$*

# Output / cache
output/
# Trainer output roots, in case one is run with the repo as CWD. The trainers
# take --out-dir/--model-dir and nothing forces them outside the repo, so a
# mistyped path drops checkpoints here.
/output_*/
/sweep_*/
/experiments_out/
/_shared_cache/
*.DS_Store

# Jupyter
.ipynb_checkpoints/

# Editor
.claude/
.gradio/

# Local project planning notes (not for public repo)
project_notes/

# Generated training pairs (local data — images + annotations).
# Globbed so later collection generations (_v2, _v3 …) are covered too —
# an exact directory name silently let generated_training_data_v2/ through.
generated_training_data*/

# The research workspace itself is NEVER part of this repo. research/ holds
# only scripts; the corpus, splits, checkpoints and experiment outputs live at
# $TACTILE_DATA_ROOT (default ~/vlm_finetune) and are partly consent-restricted
# (AMT/CUREB). Belt-and-braces in case a symlink or copy lands here.
vlm_finetune/
TactileEval_Context_And_Data/
research/**/data/
research/**/images/
research/**/experiments_out/


# Deliberate-corruption verification batch (2026-08-19) — generated images,
# reviewed in the annotator before any ingest. Large and reproducible.
verify_generated_batch*/
